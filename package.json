{
  "name": "f4datadashb",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.17",
  "publisher": "yves0003",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yves0003/f4data_dashb.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onView:f4datadashb.dashboards",
    "onCommand:f4datadashb.importDashboard",
    "onCommand:f4datadashb.createDashboard",
    "onCommand:f4datadashb.generateDashboardInFolder",
    "onCommand:f4datadashb.removeDashboard",
    "onCommand:f4datadashb.openDashboard",
    "onCommand:f4datadashb.clearLocalCopies",
    "onCommand:f4datadashb.releaseDashboardDatabase"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "f4datadashb",
          "title": "%viewContainer.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "f4datadashb": [
        {
          "id": "f4datadashb.dashboards",
          "name": "%view.dashboards%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "f4datadashb.dashboards",
        "contents": "%welcome.dashboards%"
      }
    ],
    "commands": [
      {
        "command": "f4datadashb.importDashboard",
        "title": "%command.importDashboard%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "f4datadashb.createDashboard",
        "title": "%command.createDashboard%",
        "icon": "$(add)"
      },
      {
        "command": "f4datadashb.generateDashboardInFolder",
        "title": "%command.generateDashboardInFolder%"
      },
      {
        "command": "f4datadashb.removeDashboard",
        "title": "%command.removeDashboard%"
      },
      {
        "command": "f4datadashb.openDashboard",
        "title": "%command.openDashboard%",
        "icon": "$(eye)"
      },
      {
        "command": "f4datadashb.clearLocalCopies",
        "title": "%command.clearLocalCopies%"
      },
      {
        "command": "f4datadashb.releaseDashboardDatabase",
        "title": "%command.releaseDashboardDatabase%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "f4datadashb.localCopy": {
          "type": "string",
          "enum": ["off", "auto", "always"],
          "default": "off",
          "description": "%setting.localCopy.description%",
          "enumDescriptions": [
            "%setting.localCopy.off%",
            "%setting.localCopy.auto%",
            "%setting.localCopy.always%"
          ]
        },
        "f4datadashb.localCopyThresholdMb": {
          "type": "number",
          "minimum": 0,
          "default": 50,
          "description": "%setting.localCopyThresholdMb.description%"
        },
        "f4datadashb.localCopyKeep": {
          "type": "string",
          "pattern": "^(session|days:[0-9]+)$",
          "default": "days:7",
          "description": "%setting.localCopyKeep.description%"
        },
        "f4datadashb.reuseDuckDbInstance": {
          "type": "boolean",
          "default": false,
          "description": "%setting.reuseDuckDbInstance.description%"
        },
        "f4datadashb.duckdbIdleReleaseSeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 120,
          "description": "%setting.duckdbIdleReleaseSeconds.description%"
        },
        "f4datadashb.duckdbMaxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 4,
          "description": "%setting.duckdbMaxConcurrency.description%"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "f4datadashb.generateDashboardInFolder",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "1_create"
        }
      ],
      "view/title": [
        {
          "command": "f4datadashb.importDashboard",
          "when": "view == f4datadashb.dashboards",
          "group": "navigation"
        },
        {
          "command": "f4datadashb.createDashboard",
          "when": "view == f4datadashb.dashboards",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "f4datadashb.openDashboard",
          "when": "view == f4datadashb.dashboards && viewItem == f4datadashb.dashboardItem",
          "group": "inline"
        },
        {
          "command": "f4datadashb.removeDashboard",
          "when": "view == f4datadashb.dashboards && viewItem == f4datadashb.dashboardItem",
          "group": "navigation"
        },
        {
          "command": "f4datadashb.releaseDashboardDatabase",
          "when": "view == f4datadashb.dashboards && viewItem == f4datadashb.dashboardItem",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test",
    "package:extension": "node -e \"require('node:fs').mkdirSync('package', { recursive: true })\" && vsce package --out package/f4datadashb-0.0.17.vsix"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.5"
  }
}
